{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": [
      "@cloudflare/workers-types",
      "node"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".cloudflare/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}