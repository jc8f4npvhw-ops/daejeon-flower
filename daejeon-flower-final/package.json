{
  "name": "daejeon-flower-final",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "check:vinext": "vinext check",
    "test": "node --import tsx --test tests/*.test.ts",
    "admin:create": "node scripts/create-admin.mjs",
    "media:upload": "node --import tsx scripts/upload-media.ts",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run deploy:vinext",
    "migrate": "wrangler d1 migrations apply daejeon-flower-db --remote",
    "secret:session": "node scripts/set-session-secret.mjs",
    "preview:file": "node scripts/build-review.mjs",
    "ocr:prepare": "node scripts/prepare-ocr.mjs",
    "postinstall": "node scripts/prepare-ocr.mjs"
  },
  "dependencies": {
    "@vinext/cloudflare": "1.1.1",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261016.1",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/kor": "1.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "esbuild": "0.27.7",
    "fake-indexeddb": "6.2.6",
    "jsdom": "26.1.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vinext": "1.2.1",
    "vite": "8.0.0",
    "wrangler": "4.151.1"
  }
}
